[sub_resource type="GDScript" id="GDScript_uchyk"]
script/source = "extends \"res://scripts/main_menu.gd\"


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
	
func _on_pressed() -> void:
	print(\"_on_pressed\")
	# 1. Gera um número PIN aleatório de 4 dígitos (ex: entre 1000 e 9999)
	var pin_gerado: int = randi_range(1000, 9999)
	
	# 2. Exibe o PIN na interface do teu jogo
	if has_node(\"LabelCodigo\"):
		$LabelCodigo.text = \"Código da Sala: \" + str(pin_gerado)
	
	print(\"Criando sala silenciosa com o PIN: \", pin_gerado)
	
	# 3. Chama o Game Center em background com o PIN gerado
	GameManager.buscar_partida_por_codigo(pin_gerado)
	#GameManager.request_match()
"

